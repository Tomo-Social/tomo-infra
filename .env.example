POSTGRES_USER=tomo
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=tomo
TOMO_WEB_IMAGE=ghcr.io/your-org/tomo-web:latest
TOMO_SIGNALING_IMAGE=ghcr.io/your-org/tomo-signaling:latest
TOMO_GAME_SERVER_IMAGE=ghcr.io/your-org/tomo-game-server:latest
# Preferred future name; when empty, TOMO_GAME_SERVER_IMAGE remains the compatibility fallback.
TOMO_RETRO_STREAM_SERVER_IMAGE=
AV_STREAM_SERVER_IMAGE=ghcr.io/your-org/tomo-av-stream-server:latest
# Configura sólo las fuentes disponibles en el host del worker.
CAMERA_DEVICE_HOST=/dev/video0
X11_SOCKET_HOST=/tmp/.X11-unix
PULSE_SOCKET_HOST=/run/user/1000/pulse
INPUT_SOCKET_HOST_DIR=/srv/tomo/input
PUBLIC_IP=replace-with-public-ip
TURN_URL=turn:replace-with-public-ip:3478?transport=udp
TURN_SHARED_SECRET=replace-with-a-long-random-secret
# Server-side integration key; generate at least 24 random characters.
TOMO_RETRO_API_KEY=replace-with-another-long-random-secret
# Optional multi-client alternative: {"discord":"secret...","mobile":"secret..."}
TOMO_RETRO_API_KEYS=
ROMS_HOST_DIR=./roms
BIOS_HOST_DIR=./bios
