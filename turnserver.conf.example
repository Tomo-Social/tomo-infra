# Copy to turnserver.conf and replace every placeholder before deployment.
listening-port=3478
tls-listening-port=5349
listening-ip=0.0.0.0
relay-ip=YOUR_PUBLIC_IP
external-ip=YOUR_PUBLIC_IP
min-port=49152
max-port=65535
use-auth-secret
static-auth-secret=REPLACE_WITH_A_LONG_RANDOM_SECRET
realm=tomo.local
no-loopback-peers
no-multicast-peers
log-file=stdout
simple-log
relay-threads=2
total-quota=128
stale-nonce=600
